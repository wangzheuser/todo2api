+def run_concurrent_accounts(
+    target_count: int,
+    workers: int,
+    worker: Callable[[int, float], dict | None],
+) -> tuple[int, int]:
+    """维持滚动并发，失败任务自动补位直到达到成功目标。"""
+    success = 0
+    failed = 0
+    attempted = 0
+    next_task_id = 1
+    pool = ThreadPoolExecutor(max_workers=workers)
+    future_map = {}
+
+    def fill_slots() -> None:
+        nonlocal next_task_id
+        slots = min(workers, target_count - success) - len(future_map)
+        for _ in range(max(0, slots)):
+            task_id = next_task_id
+            next_task_id += 1
+            initial_delay = (task_id - 1) * 1.5 if task_id <= workers else 0
+            future_map[pool.submit(worker, task_id, initial_delay)] = task_id
+
+    fill_slots()
+    try:
+        while future_map:
+            completed, _ = wait(future_map, return_when=FIRST_COMPLETED)
+            for future in completed:
+                attempted += 1
+                task_id = future_map.pop(future)
+                try:
+                    result = future.result()
+                except Exception as error:
+                    log(task_id, f"❌ 线程崩溃: {error}")
+                    result = None
+                if result:
+                    save_result(result)
+                    success += 1
+                else:
+                    failed += 1
+                print(
+                    f"    成功进度: {success}/{target_count}  "
+                    f"尝试: {attempted}  失败重试: {failed}"
+                )
+            fill_slots()
+    except KeyboardInterrupt:
+        for future in future_map:
+            future.cancel()
+        pool.shutdown(wait=False, cancel_futures=True)
+        raise
+    else:
+        pool.shutdown(wait=True)
+    return success, failed
+
