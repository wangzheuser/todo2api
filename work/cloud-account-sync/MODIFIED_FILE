class RequestIntervalGate:
    """在线程间将目标请求按固定最小间隔排队。"""

    def __init__(self, interval_seconds: float):
        self.interval_seconds = max(0.0, float(interval_seconds))
        self.next_allowed = 0.0
        self.cooldown_until = 0.0
        self.lock = threading.Lock()

    def wait_for_cooldown(self) -> float:
        started = time.monotonic()
        while True:
            with self.lock:
                delay = self.cooldown_until - time.monotonic()
            if delay <= 0:
                return time.monotonic() - started
            time.sleep(delay)

    def wait(self) -> float:
        started = time.monotonic()
        while True:
            with self.lock:
                now = time.monotonic()
                delay = max(self.next_allowed, self.cooldown_until) - now
                if delay <= 0:
                    self.next_allowed = now + self.interval_seconds
                    return time.monotonic() - started
            time.sleep(delay)

    def defer(self, seconds: float) -> None:
        with self.lock:
            self.cooldown_until = max(
                self.cooldown_until,
                time.monotonic() + max(0.0, float(seconds)),
            )


class CloudAccountSync:
    """通过 todo2api 管理会话持久同步新注册的 API Key。"""

    def __init__(
        self,
        base_url: str,
        username: str,
        password: str,
        *,
        queue_dir: Path = SCRIPT_DIR,
        timeout: int = 15,
    ):
        parsed = urlparse(str(base_url or "").strip())
        host = (parsed.hostname or "").casefold()
        if parsed.scheme not in {"http", "https"} or not parsed.netloc:
            raise ValueError("云端项目地址必须是完整的 HTTP(S) URL")
        if parsed.scheme == "http" and host not in {"localhost", "127.0.0.1", "::1"}:
            raise ValueError("公网云端同步必须使用 HTTPS")
        if parsed.username or parsed.password or parsed.query or parsed.fragment:
            raise ValueError("云端项目地址不能包含凭据、查询参数或片段")
        if not str(username or "").strip() or not password:
            raise ValueError("云端管理员账号和密码不能为空")

        origin_host = parsed.netloc
        self.origin = f"{parsed.scheme}://{origin_host}"
        self.base_url = f"{self.origin}{parsed.path.rstrip('/')}"
        self.username = str(username).strip()
        self.password = str(password)
        self.timeout = max(1, int(timeout))
        target_hash = hashlib.sha256(self.base_url.encode("utf-8")).hexdigest()[:12]
        self.queue_file = queue_dir / f"cloud_sync_pending.{target_hash}.json"
        self.lock = threading.Lock()
        self.session = requests.Session()
        self.session.trust_env = False
        self.auth_failed = False
        self.last_error = ""
        self.memory_pending: list[str] = []
        self._load_pending()

    def _load_pending(self) -> list[str]:
        try:
            body = json.loads(self.queue_file.read_text(encoding="utf-8"))
        except FileNotFoundError:
            return []
        except (OSError, json.JSONDecodeError) as error:
            raise ValueError(f"读取云端同步队列失败: {error}") from error
        if not isinstance(body, dict) or body.get("base_url") != self.base_url:
            raise ValueError("云端同步队列目标与当前配置不一致")
        values = body.get("keys")
        if not isinstance(values, list):
            raise ValueError("云端同步队列格式无效")
        return list(dict.fromkeys(str(value).strip() for value in values if str(value).strip()))

    def _write_pending(self, keys: list[str]) -> None:
        temporary = self.queue_file.with_suffix(".tmp")
        with open(temporary, "w", encoding="utf-8") as output:
            json.dump({"base_url": self.base_url, "keys": keys}, output, ensure_ascii=False)
            output.flush()
            os.fsync(output.fileno())
        temporary.replace(self.queue_file)

    def enqueue(self, keys: list[str]) -> None:
        with self.lock:
            pending = self._load_pending()
            added = [str(key).strip() for key in keys if str(key).strip()]
            pending.extend(added)
            try:
                self._write_pending(list(dict.fromkeys(pending)))
            except OSError as error:
                self.memory_pending = list(dict.fromkeys(self.memory_pending + added))
                self.last_error = f"写入待同步队列失败: {error}"

    def reconcile_output(self, output_file: Path) -> int:
        """把崩溃窗口中仅存在于队列的 Key 补回本地输出。"""
        with self.lock:
            pending = self._load_pending()
        if not pending:
            return 0
        try:
            existing = set(output_file.read_text(encoding="utf-8").splitlines())
        except OSError:
            existing = set()
        missing = [key for key in pending if key not in existing]
        if missing:
            with open(output_file, "a", encoding="utf-8") as output:
                output.writelines(f"{key}\n" for key in missing)
                output.flush()
                os.fsync(output.fileno())
        return len(missing)

    def pending_count(self) -> int:
        with self.lock:
            return len(set(self._load_pending()) | set(self.memory_pending))

    def _login(self) -> bool:
        if self.auth_failed:
            return False
        try:
            response = self.session.post(
                f"{self.base_url}/api/auth/login",
                json={"username": self.username, "password": self.password},
                headers={"Origin": self.origin},
                timeout=self.timeout,
            )
        except requests.RequestException as error:
            self.last_error = str(error).splitlines()[0]
            return False
        if response.status_code != 200:
            self.last_error = f"管理员登录返回 HTTP {response.status_code}"
            if response.status_code in {401, 403, 429}:
                self.auth_failed = True
            return False
        self.last_error = ""
        return True

    def _post_keys(self, keys: list[str]) -> requests.Response | None:
        try:
            return self.session.post(
                f"{self.base_url}/api/accounts/bulk",
                json={"keys": keys},
                headers={"Origin": self.origin},
                timeout=self.timeout,
            )
        except requests.RequestException as error:
            self.last_error = str(error).splitlines()[0]
            return None

    def flush_pending(self) -> int:
        """同步当前目标的全部积压，返回剩余数量。"""
        with self.lock:
            pending = self._load_pending()
            if self.memory_pending:
                pending = list(dict.fromkeys(pending + self.memory_pending))
                try:
                    self._write_pending(pending)
                except OSError as error:
                    self.last_error = f"写入待同步队列失败: {error}"
                    log(0, f"⚠️ 云端同步暂未完成: {self.last_error}; 待同步 {len(pending)}")
                    return len(pending)
                self.memory_pending = []
            while pending and not self.auth_failed:
                batch = pending[:1000]
                if not self.session.cookies and not self._login():
                    break
                response = self._post_keys(batch)
                if response is None:
                    break
                if response.status_code == 401:
                    self.session.cookies.clear()
                    if not self._login():
                        break
                    response = self._post_keys(batch)
                    if response is None:
                        break
                if response.status_code != 200:
                    self.last_error = f"账号导入返回 HTTP {response.status_code}"
                    if response.status_code in {401, 403}:
                        self.auth_failed = True
                    break
                try:
                    body = response.json()
                    results = body["results"]
                except (ValueError, KeyError, TypeError):
                    self.last_error = "账号导入响应格式无效"
                    break
                if not isinstance(results, list) or len(results) != len(batch):
                    self.last_error = "账号导入响应数量不匹配"
                    break
                synced = {
                    key
                    for key, item in zip(batch, results)
                    if isinstance(item, dict) and item.get("status") in {"created", "duplicate"}
                }
                pending = [key for key in pending if key not in synced]
                try:
                    self._write_pending(pending)
                except OSError as error:
                    self.last_error = f"更新待同步队列失败: {error}"
                    pending = self._load_pending()
                    log(0, f"⚠️ 云端同步暂未完成: {self.last_error}; 待同步 {len(pending)}")
                    return len(pending)
                failed = len(batch) - len(synced)
                log(
                    0,
                    f"☁️ 云端账号池同步: 成功 {len(synced)}, "
                    f"失败 {failed}, 待同步 {len(pending)}",
                )
                if failed:
                    self.last_error = f"{failed} 个 Key 导入失败"
                    break
                self.last_error = ""
            if pending and self.last_error:
                log(0, f"⚠️ 云端同步暂未完成: {self.last_error}; 待同步 {len(pending)}")
            return len(pending)

    def close(self) -> None:
        self.session.close()


def load_rejected_domains() -> set[str]:
    """读取目标业务已明确拒绝的邮箱域名。"""
    try:
        return {
            line.strip().casefold()
            for line in REJECTED_DOMAINS_FILE.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        }
    except OSError:
        return set()


def record_rejected_domain(domain: str) -> bool:
    """将明确拒绝的域名去重追加到持久黑名单。"""
    normalized = str(domain or "").strip().casefold()
    if not normalized:
        return False
    with REJECTED_DOMAIN_LOCK:
        if normalized in load_rejected_domains():
            return False
        with open(REJECTED_DOMAINS_FILE, "a", encoding="utf-8") as output:
            output.write(f"{normalized}\n")
    return True


def load_working_mail_channels() -> list[dict]:
    """读取完成实测并至少成功一次的 MailPoolHub 渠道。"""
    try:
        body = json.loads(WORKING_MAIL_CHANNELS_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    channels = body.get("channels") if isinstance(body, dict) else None
    if not isinstance(channels, list):
        return []
    return [
        channel
        for channel in channels
        if isinstance(channel, dict) and str(channel.get("provider") or "").strip()
    ]


def normalize_proxy_url(proxy_url: str) -> str:
    """兼容 Resin 的 ``scheme://platform.account:token:port`` 简写。"""
    value = str(proxy_url or "").strip()
    parsed = urlparse(value)
    try:
        port = parsed.port
    except ValueError:
        port = None
    if parsed.scheme in {"http", "https", "socks5"} and parsed.hostname and port:
        return value

    shorthand = re.fullmatch(
        r"(?P<scheme>https?|socks5)://(?P<username>[^:/@]+):(?P<password>[^:/@]+):(?P<port>\d+)",
        value,
    )
    if shorthand:
        port = int(shorthand.group("port"))
        if 1 <= port <= 65535:
            return (
                f"{shorthand.group('scheme')}://{shorthand.group('username')}:"
                f"{shorthand.group('password')}@127.0.0.1:{port}"
            )
    raise ValueError(
        "代理 URL 无效；请使用 http://用户:密码@主机:端口，"
        "或 Resin 简写 http://平台.{uuid}:口令:端口"
    )


def resolve_proxy_templates(
    proxies: dict | None,
    platform: str = "",
) -> dict | None:
    """为单次注册解析共享的 Resin 粘性会话 UUID。"""
    if not proxies:
        return None
    session_id = uuid4().hex
    resolved = {}
    for key, value in proxies.items():
        normalized = normalize_proxy_url(value)
        if platform:
            normalized = re.sub(
                r"(?<=://)[^.@:/]+(?=\.)",
                platform,
                normalized,
                count=1,
            )
        resolved[key] = normalized.replace("{uuid}", session_id)
    return resolved


def solve_turnstile(
    proxy_url: str = "",
    *,
    site_key: str = TURNSTILE_SITE_KEY,
    browser_channel: str = "chrome",
    headless: bool = False,
    timeout: int = 45,
) -> str:
    """在目标页面生成 Turnstile token，并保持与业务请求相同的代理出口。"""
    try:
        from patchright.sync_api import sync_playwright
    except ImportError as error:
        raise RuntimeError("缺少 patchright，请执行 pip install -r requirements.txt") from error

    proxy_options = None
    if proxy_url:
        parsed = urlparse(proxy_url)
        if parsed.scheme not in {"http", "https", "socks5"} or not parsed.hostname or not parsed.port:
            raise ValueError("Turnstile 代理必须是完整 URL")
        proxy_options = {"server": f"{parsed.scheme}://{parsed.hostname}:{parsed.port}"}
        if parsed.username:
            proxy_options["username"] = unquote(parsed.username)
            proxy_options["password"] = unquote(parsed.password or "")

    script = f"""
    (() => {{
      const container = document.createElement('div');
      container.id = 'todo2api-turnstile';
      document.body.appendChild(container);
      const load = attempt => {{
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&retry=' + attempt;
        script.onload = () => {{
          try {{
            window.turnstile.render('#todo2api-turnstile', {{
              sitekey: {json.dumps(site_key)},
              callback: token => document.body.dataset.turnstileToken = token,
              'error-callback': code => document.body.dataset.turnstileError = 'error:' + code,
              'timeout-callback': () => document.body.dataset.turnstileError = 'timeout'
            }});
          }} catch (error) {{
            document.body.dataset.turnstileError = 'render:' + error;
          }}
        }};
        script.onerror = () => attempt < 5
          ? setTimeout(() => load(attempt + 1), 500)
          : document.body.dataset.turnstileError = 'load';
        document.head.appendChild(script);
      }};
      load(0);
    }})();
    """

    with sync_playwright() as playwright:
        launch_options = {"headless": headless}
        if browser_channel:
            launch_options["channel"] = browser_channel
        browser = playwright.chromium.launch(**launch_options)
        context_options = {"viewport": {"width": 1000, "height": 700}}
        if proxy_options:
            context_options["proxy"] = proxy_options
        context = browser.new_context(**context_options)
        page = context.new_page()
        try:
            response = page.goto(TODO_ORIGIN, wait_until="domcontentloaded", timeout=30_000)
            if not response or response.status != 200:
                raise RuntimeError(f"Turnstile 页面加载失败：HTTP {response.status if response else 0}")
            page.add_script_tag(content=script)
            deadline = time.monotonic() + max(10, timeout)
            while time.monotonic() < deadline:
                page.wait_for_timeout(1000)
                token = page.locator("body").get_attribute("data-turnstile-token")
                if token:
                    return token
                error = page.locator("body").get_attribute("data-turnstile-error")
                if error and error != "timeout":
                    raise RuntimeError(f"Turnstile 求解失败：{error}")
                for frame in page.frames:
                    if "challenges.cloudflare.com" not in frame.url:
                        continue
                    try:
                        frame.locator("input[type=checkbox]").first.click(timeout=500, force=True)
                    except Exception:
                        pass
            raise TimeoutError("Turnstile 求解超时")
        finally:
            browser.close()


