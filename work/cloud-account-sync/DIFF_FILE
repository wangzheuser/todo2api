+                    f"☁️ 云端账号池同步: 成功 {len(synced)}, "
+                    f"失败 {failed}, 待同步 {len(pending)}",
+                )
+                if failed:
+                    self.last_error = f"{failed} 个 Key 导入失败"
+                    break
+                self.last_error = ""
+            if pending and self.last_error:
+                log(0, f"⚠️ 云端同步暂未完成: {self.last_error}; 待同步 {len(pending)}")
+            return len(pending)
+
+    def close(self) -> None:
+        self.session.close()
