+
+    def _load_pending(self) -> list[str]:
+        try:
+            body = json.loads(self.queue_file.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            return []
+        except (OSError, json.JSONDecodeError) as error:
+            raise ValueError(f"读取云端同步队列失败: {error}") from error
+        if not isinstance(body, dict) or body.get("base_url") != self.base_url:
+            raise ValueError("云端同步队列目标与当前配置不一致")
+        values = body.get("keys")
+        if not isinstance(values, list):
+            raise ValueError("云端同步队列格式无效")
+        return list(dict.fromkeys(str(value).strip() for value in values if str(value).strip()))
+
+    def _write_pending(self, keys: list[str]) -> None:
+        temporary = self.queue_file.with_suffix(".tmp")
+        with open(temporary, "w", encoding="utf-8") as output:
+            json.dump({"base_url": self.base_url, "keys": keys}, output, ensure_ascii=False)
+            output.flush()
+            os.fsync(output.fileno())
+        temporary.replace(self.queue_file)
+
+    def enqueue(self, keys: list[str]) -> None:
+        with self.lock:
+            pending = self._load_pending()
+            added = [str(key).strip() for key in keys if str(key).strip()]
+            pending.extend(added)
+            try:
+                self._write_pending(list(dict.fromkeys(pending)))
+            except OSError as error:
+                self.memory_pending = list(dict.fromkeys(self.memory_pending + added))
+                self.last_error = f"写入待同步队列失败: {error}"
+
+    def reconcile_output(self, output_file: Path) -> int:
+        """把崩溃窗口中仅存在于队列的 Key 补回本地输出。"""
+        with self.lock:
+            pending = self._load_pending()
+        if not pending:
+            return 0
+        try:
+            existing = set(output_file.read_text(encoding="utf-8").splitlines())
+        except OSError:
+            existing = set()
+        missing = [key for key in pending if key not in existing]
+        if missing:
+            with open(output_file, "a", encoding="utf-8") as output:
+                output.writelines(f"{key}\n" for key in missing)
+                output.flush()
+                os.fsync(output.fileno())
+        return len(missing)
+
+    def pending_count(self) -> int:
+        with self.lock:
+            return len(set(self._load_pending()) | set(self.memory_pending))
+
+    def _login(self) -> bool:
+        if self.auth_failed:
+            return False
+        try:
+            response = self.session.post(
+                f"{self.base_url}/api/auth/login",
+                json={"username": self.username, "password": self.password},
+                headers={"Origin": self.origin},
+                timeout=self.timeout,
+            )
+        except requests.RequestException as error:
+            self.last_error = str(error).splitlines()[0]
+            return False
+        if response.status_code != 200:
+            self.last_error = f"管理员登录返回 HTTP {response.status_code}"
+            if response.status_code in {401, 403, 429}:
+                self.auth_failed = True
+            return False
+        self.last_error = ""
+        return True
+
+    def _post_keys(self, keys: list[str]) -> requests.Response | None:
+        try:
+            return self.session.post(
+                f"{self.base_url}/api/accounts/bulk",
+                json={"keys": keys},
+                headers={"Origin": self.origin},
+                timeout=self.timeout,
+            )
+        except requests.RequestException as error:
+            self.last_error = str(error).splitlines()[0]
+            return None
+
+    def flush_pending(self) -> int:
+        """同步当前目标的全部积压，返回剩余数量。"""
+        with self.lock:
+            pending = self._load_pending()
+            if self.memory_pending:
+                pending = list(dict.fromkeys(pending + self.memory_pending))
+                try:
+                    self._write_pending(pending)
+                except OSError as error:
+                    self.last_error = f"写入待同步队列失败: {error}"
+                    log(0, f"⚠️ 云端同步暂未完成: {self.last_error}; 待同步 {len(pending)}")
+                    return len(pending)
+                self.memory_pending = []
+            while pending and not self.auth_failed:
+                batch = pending[:1000]
+                if not self.session.cookies and not self._login():
+                    break
+                response = self._post_keys(batch)
+                if response is None:
+                    break
+                if response.status_code == 401:
+                    self.session.cookies.clear()
+                    if not self._login():
+                        break
+                    response = self._post_keys(batch)
+                    if response is None:
+                        break
+                if response.status_code != 200:
+                    self.last_error = f"账号导入返回 HTTP {response.status_code}"
+                    if response.status_code in {401, 403}:
+                        self.auth_failed = True
+                    break
+                try:
+                    body = response.json()
+                    results = body["results"]
+                except (ValueError, KeyError, TypeError):
+                    self.last_error = "账号导入响应格式无效"
+                    break
+                if not isinstance(results, list) or len(results) != len(batch):
+                    self.last_error = "账号导入响应数量不匹配"
+                    break
+                synced = {
+                    key
+                    for key, item in zip(batch, results)
+                    if isinstance(item, dict) and item.get("status") in {"created", "duplicate"}
+                }
